# AgentKit — Variables de entorno (Reduz+ Energia)
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
#
# NUNCA subas el archivo .env a GitHub.
# Los valores reales de producción están en las Variables de Railway
# (ver ACESSOS.md para la lista completa, credenciales incluidas).

# ── Anthropic API ──────────────────────────────────────────
# Obtener en: https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# ── Proveedor de WhatsApp ──────────────────────────────────
# Único proveedor soportado en este proyecto: meta
WHATSAPP_PROVIDER=meta

# ── Meta Cloud API ─────────────────────────────────────────
# Configurar en: https://developers.facebook.com
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=agentkit-verify
# WABA ID — necesario para la gestión automática de templates (agent/meta_templates.py)
META_WABA_ID=

# ── Panel de administración (/admin) ───────────────────────
ADMIN_PASSWORD=

# ── Número del consultor (notificaciones y agenda personal) ─
# Formato: código de país + número, sin espacios ni "+" (ej: 351937157871)
NUMERO_CONSULTOR=

# ── URL pública del servicio (usada en links de notificaciones) ─
APP_BASE_URL=https://reduz-mais-energia-production.up.railway.app

# ── Cal.com (agendamiento de llamadas) ─────────────────────
# Configurar en: https://cal.com
CALCOM_API_KEY=
CALCOM_USERNAME=geral-reduzmais.com
CALCOM_EVENT_SLUG=chamada-reduz-energia

# ── iCloud Calendar (sincronización de llamadas agendadas) ─
# ICLOUD_APP_PASSWORD debe ser una "contraseña de aplicación" generada en
# appleid.apple.com → Seguridad → Contraseñas específicas de aplicación
# (nunca la contraseña normal del Apple ID)
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=

# ── Outlook / Microsoft 365 (sincronización alternativa, opcional) ─
# Requiere una app registrada en Microsoft Entra ID (Azure) con permiso
# delegado Calendars.ReadWrite. Tras configurar estas 3, hace falta además
# un paso manual de autorización en /admin/outlook/conectar.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
# AZURE_REDIRECT_URI= (opcional — por defecto ya apunta a
# https://reduz-mais-energia-production.up.railway.app/admin/outlook/callback)

# ── Attio CRM (sincronización de leads escalados por WhatsApp) ─
# Token dedicado, generado en Attio → Settings → Developers → Access tokens
# Scopes: Records (Read-write), Object Configuration (Read), Notes (Read-write)
ATTIO_API_KEY=
# Workspace member usado como owner de los Deals creados (opcional — ya
# tiene un valor por defecto válido para este workspace en el código)
# ATTIO_OWNER_ACTOR_ID=

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Base de datos ─────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Produccion (PostgreSQL en Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
